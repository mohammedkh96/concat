import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";
import { PaneScroll } from "../workspace/pane.slint";

// Captions: what the tray's Captions tool opens.
//
// Two sheets in one, and a switch between them: "Use voice from timeline".
// On, the words are a clip's: one picked from the timeline's clips that
// have sound, through the transcriber, cut to the words' own timing. Off,
// they are a script typed here, one title per sentence at reading pace,
// laid down from the playhead. The list holds only clips with sound, so a
// silent video cannot be sent to the transcriber. The switch starts on
// when the sheet is opened on a clip with sound - from the clip's menu, or
// with one selected - and off otherwise. Then where the lines sit and how
// big they are, and one button. While it runs
// the sheet is the progress report: a transcription knows how far through
// the sound it is, so it gets a real bar and not a sweep. The language is
// the transcriber's to work out.

export struct CaptionsSheetData {
    open: bool,
    /// "Use voice from timeline": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    running: bool,
    /// 0..1: where the transcription surely is.
    progress: float,
    /// Where the step under way leaves the bar, 0..1.
    ceiling: float,
    /// Seconds that step should take.
    step: float,
    /// Seconds of the run still to go, once the work has been timed;
    /// negative before.
    left: float,
    /// What the run is doing, in words.
    stage: string,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
    /// Use Kurdish AI (Gemini) instead of local whisper
    is-kurdish-ai: bool,
    /// 0 Kurdish, 1 Arabic, 2 Auto
    kurdish-language: int,
    /// Whether to auto-translate captions to Central Kurdish
    translate-to-kurdish: bool,
    /// 0 None, 1 Fade, 2 Slide Up, 3 Slide Down, 4 Zoom In, 5 Bounce
    animation: int,
    /// 0 Off, 1 Rounded, 2 Square, 3 Underline, 4 Highlight
    highlight-style: int,
    /// Spoken languages options
    spoken-languages: [string],
    /// Target languages options for translation
    target-languages: [string],
    /// Selected target language index
    target-language: int,
    /// Modern viral caption templates (Dimension Story, Submagic, Hormozi, etc.)
    caption-templates: [string],
    caption-template: int,
    /// Gemini model options
    gemini-models: [string],
    gemini-model: int,
    /// Whether custom Gemini API key is configured
    has-gemini-key: bool,
    gemini-key-preview: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback kurdish-ai-toggled(on: bool);
    callback kurdish-language-changed(index: int);
    callback translate-toggled(on: bool);
    callback target-language-changed(index: int);
    callback caption-template-changed(index: int);
    callback animation-changed(index: int);
    callback highlight-changed(index: int);
    callback gemini-model-changed(index: int);
    callback login-gemini();
    callback gemini-key-edited(text: string);
    callback import-subtitles();
    callback export-srt();
    callback export-ass();
    callback translate-timeline();
    callback begin();
    callback cancel();

    property <bool> from-voice: root.data.from-voice;

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: 520px;
    surface-height: root.data.running ? 300px : 720px;
    dismissable: !root.data.running;

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the sheet re-seeds it when it opens and never
    // while it is being typed into.
    property <string> draft;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

    PaneScroll {
        finger: true;
        if !root.data.running: DialogSection {
            first: true;
            Button {
                block: true;
                label: I18n.t("captions.importSubtitles");
                glyph: Glyph.import;
                ghost: true;
                clicked => { root.import-subtitles(); }
            }
            Text {
                text: I18n.t("captions.importHelp");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        // Prominent Mode Selector: Audio AI vs Manual Script
        if !root.data.running: HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 2px;

            SegmentedControl {
                options: [
                    "🎙️ " + I18n.t("common.transcriber"),
                    "✍️ " + I18n.t("common.script"),
                ];
                current: root.from-voice ? 0 : 1;
                changed(index) => { root.voice-toggled(index == 0); }
            }
        }

        if !root.data.running && root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.transcriber");

            if root.data.sources.length == 0: Rectangle {
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.line;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    alignment: center;

                    Icon {
                        glyph: Glyph.import;
                        size: 16px;
                        tint: Theme.accent;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: I18n.t("captions.noVoiceOnTimeline");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }

            if root.data.sources.length > 0: DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                SegmentedControl {
                    options: ["Kurdish AI (Gemini)", "Local Whisper"];
                    current: root.data.is-kurdish-ai ? 0 : 1;
                    changed(index) => { root.kurdish-ai-toggled(index == 0); }
                }
            }

            if root.data.is-kurdish-ai: DialogRow {
                label: "Gemini Model";
                Select {
                    options: root.data.gemini-models;
                    current: root.data.gemini-model;
                    placeholder: "Gemini 2.0 Flash (Recommended)";
                    changed(index) => { root.gemini-model-changed(index); }
                }
            }

            if root.data.is-kurdish-ai: DialogRow {
                label: "Gemini API";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Text {
                        text: root.data.has-gemini-key ? ("🟢 " + root.data.gemini-key-preview) : "🔴 Not Connected";
                        color: root.data.has-gemini-key ? Theme.accent : Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }

                    Button {
                        label: "🔑 Login & Get Key";
                        primary: !root.data.has-gemini-key;
                        clicked => { root.login-gemini(); }
                    }
                }
            }

            if root.data.is-kurdish-ai: DialogRow {
                label: "API Key";
                Field {
                    placeholder: "Paste Gemini API Key (AIzaSy...)";
                    secret: true;
                    value: root.data.has-gemini-key ? "••••••••••••••••••••" : "";
                    edited(text) => { root.gemini-key-edited(text); }
                }
            }

            if root.data.is-kurdish-ai: DialogRow {
                label: "Language";
                Select {
                    options: root.data.spoken-languages;
                    current: root.data.kurdish-language;
                    placeholder: "Auto Detect (خۆکار)";
                    changed(index) => { root.kurdish-language-changed(index); }
                }
            }

            if root.data.is-kurdish-ai: HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: "Translate Captions (وەرگێڕان)";
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.data.translate-to-kurdish;
                        toggled(on) => { root.translate-toggled(on); }
                    }
                }
            }

            if root.data.is-kurdish-ai && root.data.translate-to-kurdish: DialogRow {
                label: "Translate To";
                Select {
                    options: root.data.target-languages;
                    current: root.data.target-language;
                    placeholder: "Kurdish (Sorani)";
                    changed(index) => { root.target-language-changed(index); }
                }
            }

            if !root.data.is-kurdish-ai: DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("common.noneInstalled");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            if !root.data.is-kurdish-ai && !root.data.ready: Text {
                text: I18n.t("captions.downloadTranscriberModelFirst");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && !root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.script");

            Rectangle {
                height: 104px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: script.has-focus ? Theme.accent : Theme.line;
                clip: true;

                script := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                    // Home and End are unbound in Slint on macOS and would
                    // walk up to the window's playhead shortcuts.
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 10px;
                    y: 8px;
                    text: I18n.t("captions.typeWordsPutScreen");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        if !root.data.running: DialogSection {
            title: I18n.t("captions.captions");

            DialogRow {
                label: "Viral Template (قالب)";
                Select {
                    options: root.data.caption-templates;
                    current: root.data.caption-template;
                    placeholder: "✨ Dimension Story (Moonshot 3D)";
                    changed(index) => { root.caption-template-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.placement");
                SegmentedControl {
                    options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.size");
                SegmentedControl {
                    options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.animation");
                Select {
                    options: [
                        "None (هیچ)",
                        "Fade (کاڵبوونەوە)",
                        "Slide Up (خلیسکان بەرەو سەرەوە)",
                        "Slide Down (خلیسکان بەرەو خوارەوە)",
                        "Slide Left (خلیسکان لە چەپ)",
                        "Slide Right (خلیسکان لە ڕاست)",
                        "Zoom In (نزیکبوونەوە)",
                        "Zoom Out (دوورکەوتنەوە)",
                        "Bounce Pop (بازدان)",
                        "Drop Stamp (کەوتنی بەهێز)",
                        "Glitch Shake (لەرزینی گلیچ)",
                        "Pulse Beat (لێدانی نەرم)",
                        "Kinetic Drift (خلیسکانی دراماتیك)"
                    ];
                    current: root.data.animation;
                    placeholder: "None (هیچ)";
                    changed(index) => { root.animation-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.highlight");
                Select {
                    options: [
                        "Off (ناچالاک)",
                        "Rounded (گۆڕاو)",
                        "Square (چوارگۆشە)",
                        "Underline (هێڵی)",
                        "Highlight (مارکەر)",
                        "Liquid Glass White (شووشەی شلی سپی)",
                        "Liquid Glass Dark (شووشەی شلی تاریک)"
                    ];
                    current: root.data.highlight-style;
                    placeholder: "Off (ناچالاک)";
                    changed(index) => { root.highlight-changed(index); }
                }
            }

            DialogRow {
                label: "Target Language (ترجمة)";
                Select {
                    options: root.data.target-languages;
                    current: root.data.target-language;
                    placeholder: "Arabic / عەرەبی (العربية الفصحى)";
                    changed(index) => { root.target-language-changed(index); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;

                Button {
                    label: I18n.t("captions.exportSrt");
                    glyph: Glyph.export;
                    ghost: true;
                    clicked => { root.export-srt(); }
                }

                Button {
                    label: I18n.t("captions.exportAss");
                    glyph: Glyph.export;
                    ghost: true;
                    clicked => { root.export-ass(); }
                }

                Button {
                    label: "Translate Timeline (ترجمة)";
                    glyph: Glyph.sparkle;
                    ghost: true;
                    clicked => { root.translate-timeline(); }
                }
            }

            Text {
                text: root.from-voice
                    ? I18n.t("captions.oneTitlePerPhrase")
                    : I18n.t("captions.oneTitlePerSentence");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: VerticalLayout {
                spacing: 8px;

                row := HorizontalLayout {
                    spacing: 8px;
                    // The time left, once the work has been timed: counted down
                    // from the last report, and gone in the last second.
                    property <int> left: Math.ceil(Math.max(0, root.data.left - bar.since / 1s));

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.stage;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    if root.data.left >= 0 && row.left > 0: Text {
                        text: I18n.t2("common.aboutLeft", "\{Math.floor(row.left / 60)}",
                            (Math.mod(row.left, 60) < 10 ? "0" : "") + "\{Math.mod(row.left, 60)}");
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{Math.floor(bar.shown * 100)}%";
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }

                bar := Progress {
                    value: root.data.progress;
                    ceiling: root.data.ceiling;
                    step: root.data.step * 1s;
                    live: true;
                }
            }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running: Button {
                block: true;
                primary: true;
                large: true;
                glyph: Glyph.text-mark;
                label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                enabled: root.from-voice ? (root.data.is-kurdish-ai ? root.data.source >= 0 : root.data.ready && root.data.source >= 0) : root.draft != "";
                clicked => { root.begin(); }
            }
        }
    }
}
